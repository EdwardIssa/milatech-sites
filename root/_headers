# Browser caching policy (Cloudflare _headers).
# HTML is intentionally NOT matched by any rule below: it keeps the
# platform default "public, max-age=0, must-revalidate" so deploys
# are always picked up immediately. ads.txt / app-ads.txt untouched.

# Fingerprinted assets (name.<hash>.ext) never change at the same URL:
/*.*.css
  Cache-Control: public, max-age=31536000, immutable
/*.*.js
  Cache-Control: public, max-age=31536000, immutable
/*.*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Fonts: 30 days
/*.woff2
  Cache-Control: public, max-age=2592000
/*.woff
  Cache-Control: public, max-age=2592000

# CSS / JS: 1 day
/*.css
  Cache-Control: public, max-age=86400
/*.js
  Cache-Control: public, max-age=86400

# Images: 7 days
/*.png
  Cache-Control: public, max-age=604800
/*.jpg
  Cache-Control: public, max-age=604800
/*.jpeg
  Cache-Control: public, max-age=604800
/*.svg
  Cache-Control: public, max-age=604800
/*.gif
  Cache-Control: public, max-age=604800
/*.webp
  Cache-Control: public, max-age=604800
/*.ico
  Cache-Control: public, max-age=604800

# Video: 7 days
/*.mp4
  Cache-Control: public, max-age=604800
